# Секреты — никогда не коммитить
.env

# База данных сайта — своя на каждом окружении, не должна перетираться при pull
data/

# Загруженные файлы (картинки новостей/FAQ, дистрибутивы) — тоже локальные для сервера
app/static/uploads/
app/static/downloads/

# Виртуальное окружение Python
venv/

# Скомпилированные файлы Python
__pycache__/
*.pyc

# Логи, если появятся
*.log
