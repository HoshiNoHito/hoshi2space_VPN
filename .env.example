# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ должен попадать в git / никому не показываться.

# Секрет для подписи сессионных cookie сайта (сгенерируй случайную строку)
SECRET_KEY=change_me_to_a_long_random_string

# --- Доступ к панели 3x-ui ---
# URL панели, например https://your-panel-domain:2053/some_secret_path/
XUI_PANEL_URL=https://127.0.0.1:2053/
XUI_USERNAME=admin
XUI_PASSWORD=change_me

# Если вместо логина/пароля используешь Bearer API-токен (Settings -> Security -> API Token в панели),
# укажи его здесь и оставь XUI_USERNAME/XUI_PASSWORD пустыми — тогда будет использоваться токен.
XUI_API_TOKEN=

# Публичный адрес/порт сервера, который будет вписан в клиентские конфиги (VLESS/Hysteria и т.д.)
PUBLIC_SERVER_ADDRESS=your-server-ip-or-domain

# Путь к SQLite базе сайта (не путать с базой 3x-ui!)
DATABASE_URL=sqlite:///./data/site.db
